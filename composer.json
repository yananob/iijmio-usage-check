{
    "name": "yananob/iijmio-usage-checker",
    "description": "yananob/iijmio-usage-checker",
    "license": "proprietary",

    "require": {
        "php": ">= 8.2",
        "google/cloud-functions-framework": "^1.3",
        "google/cloud-firestore": "^1.40",
        "nesbot/carbon": "^3.8",
        "yananob/my-tools": "dev-main",
        "yananob/my-gcp-tools": "dev-main"
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "FUNCTION_TARGET=main php -S localhost:${PORT:-8080} vendor/google/cloud-functions-framework/router.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2",
        "phpstan/phpstan": "^1.11"
    },
    "repositories": [
        {
            "name": "packagist.org",
            "type": "composer",
            "url": "https://packagist.org"
        },
        {
            "type": "vcs",
            "url": "https://github.com/yananob/my-tools.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/yananob/my-gcp-tools.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "MyApp\\": "./src/"
        }
    }
}
