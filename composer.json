{
    "name": "yananob/iijmio-usage-checker",
    "description": "yananob/iijmio-usage-checker",
    "license": "proprietary",

    "require": {
        "php": ">= 8.2",
        "google/cloud-functions-framework": "^1.3",
        "google/cloud-firestore": "^1.37",
        "nesbot/carbon": "^3.8",
        "linecorp/line-bot-sdk": "^12.4",
        "monolog/monolog": "^3.10",
        "eftec/bladeone": "^4.19"
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "FUNCTION_TARGET=main php -S localhost:${PORT:-8080} vendor/google/cloud-functions-framework/router.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "./tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
